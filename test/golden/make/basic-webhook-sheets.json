        "position": [
          780,
          0
        ],
        "parameters": {
          "respondWith": "text",
          "responseBody": "={\"ok\": true, \"row\": \"{{ $('Google Sheets: Add Row').item.json.tableName }}\"}",
          "options": {
            "responseCode": 200,
            "responseHeaders": {
              "entries": [
                {
                  "name": "Content-Type",
                  "value": "application/json"
                }
              ]
            }
          }
        }
