              "C": "={{ $now.toFormat('yyyy-LL-dd HH:mm') }}",
              "D": "={{ ($('Form submitted').item.json.body.company || \"—\") }}"
            },
            "matchingColumns": [],
            "schema": []
          },
          "options": {
            "cellFormat": "USER_ENTERED"
          }
        }
      },
      {
        "id": "id-6",
