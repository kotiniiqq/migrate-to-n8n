            "__rl": true,
            "mode": "id",
            "value": "1AbCdEfGhIjKlMnOpQrStUvWxYz"
          },
          "sheetName": {
            "__rl": true,
            "mode": "name",
            "value": "Leads"
          },
          "columns": {
