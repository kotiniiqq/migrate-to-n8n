      {
        "id": "id-3",
        "name": "Google Sheets: Filter Rows",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          520,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Make returned at most 100 row(s) for each search: keep that many per item that reached the search.\nconst max = 100;\nconst kept = new Map();\nreturn $input.all().flatMap((item, i) => {\n  const p = $(\"Google Sheets: Filter Rows (read)\").itemMatching(i)?.pairedItem;\n  const from = (Array.isArray(p) ? p[0] : p)?.item ?? p ?? 0;\n  const n = kept.get(from) ?? 0;\n  kept.set(from, n + 1);\n  return n < max ? [{ ...item, pairedItem: { item: i } }] : [];\n});"
        }
      },
      {
        "id": "id-4",
        "name": "HTTP request",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.3,
        "position": [
