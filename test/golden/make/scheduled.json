              "leftValue": "",
              "typeValidation": "loose",
              "version": 3
            },
            "conditions": [
              {
                "id": "id-6",
                "leftValue": "={{ DateTime.fromFormat(String($('Google Sheets: Filter Rows').item.json['D'] ?? ''), 'dd.LL.yyyy') }}",
                "rightValue": "={{ $now }}",
                "operator": {
                  "type": "dateTime",
                  "operation": "before"
                }
              }
            ],
            "combinator": "and"
          },
          "looseTypeValidation": true,
          "options": {}
