          "html": "=Dear customer, invoice {{ $('Google Sheets: Filter Rows').item.json['A'] }} for {{ $('Google Sheets: Filter Rows').item.json['C'] }} EUR was due on {{ $('Google Sheets: Filter Rows').item.json['D'] }}.",
          "options": {
