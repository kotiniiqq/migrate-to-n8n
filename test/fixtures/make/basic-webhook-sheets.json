{
  "name": "Leads from the website form",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": 1450321, "maxResults": 1 },
      "mapper": {},
      "metadata": { "designer": { "x": 0, "y": 0, "name": "Form submitted" } }
    },
    {
      "id": 2,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": { "name": "fullName", "scope": "roundtrip", "value": "{{1.first_name}} {{1.last_name}}" },
      "metadata": { "designer": { "x": 300, "y": 0 } }
    },
    {
      "id": 3,
      "module": "google-sheets:addRow",
      "version": 2,
      "parameters": { "__IMTCONN__": 5486001 },
      "mapper": {
        "mode": "select",
        "spreadsheetId": "/1AbCdEfGhIjKlMnOpQrStUvWxYz",
        "sheetId": "Leads",
        "includesHeaders": true,
        "insertDataOption": "INSERT_ROWS",
        "valueInputOption": "USER_ENTERED",
        "values": {
          "0": "{{2.fullName}}",
          "1": "{{1.email}}",
          "2": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}",
          "3": "{{ifempty(1.company; \"—\")}}"
        }
      },
      "metadata": { "designer": { "x": 600, "y": 0 } }
    },
    {
      "id": 4,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": { "status": "200", "body": "{\"ok\": true, \"row\": \"{{3.tableName}}\"}", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
      "metadata": { "designer": { "x": 900, "y": 0 } }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": { "roundtrips": 1, "maxErrors": 3, "autoCommit": true, "autoCommitTriggerLast": true, "sequential": false, "confidential": false, "dataloss": false, "dlq": false, "freshVariables": false },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com"
  }
}
