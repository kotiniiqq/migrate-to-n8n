{
  "name": "Route support tickets",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": 2001, "maxResults": 1 },
      "mapper": {},
      "metadata": { "designer": { "x": 0, "y": 300 } }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": { "designer": { "x": 300, "y": 300 } },
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": false },
              "filter": { "name": "Billing", "conditions": [[{ "a": "{{1.category}}", "o": "text:equal", "b": "billing" }]] },
              "mapper": {
                "url": "https://billing.example.com/api/tickets",
                "method": "post",
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{\"subject\": \"{{1.subject}}\", \"customer\": \"{{1.email}}\"}",
                "headers": [{ "name": "X-Source", "value": "make" }],
                "qs": [],
                "parseResponse": true
              },
              "metadata": { "designer": { "x": 600, "y": 0 } }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 4,
              "module": "builtin:BasicRouter",
              "version": 1,
              "filter": { "name": "Technical", "conditions": [[{ "a": "{{1.category}}", "o": "text:equal", "b": "tech" }], [{ "a": "{{lower(1.subject)}}", "o": "text:contain:ci", "b": "error" }]] },
              "mapper": null,
              "metadata": { "designer": { "x": 600, "y": 300 } },
              "routes": [
                {
                  "flow": [
                    {
                      "id": 5,
                      "module": "slack:CreateMessage",
                      "version": 4,
                      "parameters": { "__IMTCONN__": 77001 },
                      "filter": { "name": "Urgent", "conditions": [[{ "a": "{{1.priority}}", "o": "number:greater", "b": "3" }]] },
                      "mapper": { "channel": "C0123ABCD", "text": "Urgent ticket: {{1.subject}} from {{1.email}}", "channelType": "public", "channelWType": "list" },
                      "metadata": { "designer": { "x": 900, "y": 200 } }
                    }
                  ]
                },
                {
                  "flow": [
                    {
                      "id": 6,
                      "module": "email:ActionSendEmail",
                      "version": 7,
                      "parameters": { "account": 77002 },
                      "mapper": { "to": ["support@example.com"], "subject": "Ticket: {{1.subject}}", "html": "<p>{{1.body}}</p>", "from": "" },
                      "metadata": { "designer": { "x": 900, "y": 400 } }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "json:ParseJSON",
              "version": 1,
              "parameters": { "type": "" },
              "mapper": { "json": "{{1.meta}}" },
              "metadata": { "designer": { "x": 600, "y": 600 } }
            }
          ]
        }
      ]
    }
  ],
  "metadata": { "instant": true, "version": 1, "scenario": { "roundtrips": 1, "maxErrors": 3 }, "designer": { "orphans": [] }, "zone": "us1.make.com" }
}
