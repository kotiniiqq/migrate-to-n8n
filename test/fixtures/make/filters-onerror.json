{
  "name": "Order sync with error handling",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": 3001, "maxResults": 1 },
      "mapper": {},
      "metadata": { "designer": { "x": 0, "y": 0 } }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true },
      "mapper": { "url": "https://erp.example.com/orders/{{1.order_id}}", "method": "get", "bodyType": "", "headers": [{ "name": "Authorization", "value": "Bearer {{1.token}}" }], "qs": [{ "name": "expand", "value": "lines" }], "parseResponse": true },
      "metadata": { "designer": { "x": 300, "y": 0 } },
      "onerror": [{ "id": 20, "module": "builtin:Ignore", "version": 1, "metadata": { "designer": { "x": 300, "y": 300 } } }]
    },
    {
      "id": 3,
      "module": "slack:CreateMessage",
      "version": 4,
      "parameters": { "__IMTCONN__": 77001 },
      "filter": { "name": "Has an order", "conditions": [[{ "a": "{{2.data.id}}", "o": "exist" }, { "a": "{{2.data.total}}", "o": "number:greaterorequal", "b": "100" }]] },
      "mapper": { "channel": "C0456EFGH", "text": "Big order {{2.data.id}}: {{2.data.total}}", "channelType": "public", "channelWType": "list" },
      "metadata": { "designer": { "x": 600, "y": 0 } },
      "onerror": [{ "id": 21, "module": "builtin:Break", "version": 1, "parameters": { "count": 3, "interval": 15 }, "metadata": { "designer": { "x": 600, "y": 300 } } }]
    },
    {
      "id": 4,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": { "__IMTCONN__": 5486001 },
      "mapper": { "mode": "select", "spreadsheetId": "/1ZyXwVuTsRqPoNmLkJiHgFeDcBa", "sheetId": "Orders", "rowNumber": "{{1.row}}", "values": { "0": "{{2.data.status}}" } },
      "metadata": { "designer": { "x": 900, "y": 0 } },
      "onerror": [
        { "id": 22, "module": "email:ActionSendEmail", "version": 7, "parameters": { "account": 77002 }, "mapper": { "to": ["ops@example.com"], "subject": "Sheet update failed", "html": "Order {{1.order_id}}" }, "metadata": { "designer": { "x": 900, "y": 300 } } },
        { "id": 23, "module": "builtin:Resume", "version": 1, "mapper": { "updatedRange": "" }, "metadata": { "designer": { "x": 1200, "y": 300 } } }
      ]
    }
  ],
  "metadata": { "instant": true, "version": 1, "scenario": { "roundtrips": 1, "maxErrors": 3 }, "designer": { "orphans": [] }, "zone": "eu1.make.com" }
}
